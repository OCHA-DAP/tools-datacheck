{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "tools-datacheck-wizard": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "aot": true,
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "assets": [
              "src/assets",
              {
                "glob": "**/*",
                "input": "src/hdx-styles/src/common/fonts",
                "output": "/assets/fonts"
              },
              {
                "glob": "**/*",
                "input": "src/hdx-styles/src/common/images/icons",
                "output": "/assets/icons"
              },
              {
                "glob": "filter_loading.gif",
                "input": "src/hdx-styles/src/common/images",
                "output": "/assets"
              },
              "src/favicon.ico"
            ],
            "styles": [
              "src/styles.less",
              "node_modules/handsontable/dist/handsontable.full.css"
            ],
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4200,
            "buildTarget": "tools-datacheck-wizard:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "tools-datacheck-wizard:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "tools-datacheck-wizard:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "scripts": [],
            "styles": [
              "src/styles.less",
              "node_modules/handsontable/dist/handsontable.full.css"
            ],
            "assets": [
              "src/assets",
              {
                "glob": "**/*",
                "input": "src/hdx-styles/src/common/fonts",
                "output": "/assets/fonts"
              },
              {
                "glob": "**/*",
                "input": "src/hdx-styles/src/common/images/icons",
                "output": "/assets/icons"
              },
              {
                "glob": "filter_loading.gif",
                "input": "src/hdx-styles/src/common/images",
                "output": "/assets"
              },
              "src/favicon.ico"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "tools-datacheck-wizard-e2e": {
      "root": "",
      "sourceRoot": "e2e",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "./protractor.conf.js",
            "devServerTarget": "tools-datacheck-wizard:serve"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "hdx",
      "style": "less"
    },
    "@schematics/angular:directive": {
      "prefix": "hdx"
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
